#!/usr/bin/env bash
if [[ "$OSTYPE" == "linux-gnu"* ]]; then
    unzip models/optimized_model.zip -d models/
elif [[ "$OSTYPE" == "msys" || "$OSTYPE" == "cygwin" ]]; then
    tar -xf models/optimized_model.zip -C models/
else
    echo "unknown os"

mkdir -p models

TEMP_DIR=$(mktemp -d)
cd "$TEMP_DIR"

git clone --depth 1 https://github.com
cd open_model_zoo/tools/downloader
pip install --user -r requirements.in
python3 downloader.py --name asl-recognition-0004
MODEL_SRC_XML=$(find . -type f -name "asl-recognition-0004.xml" | head -n 1)
MODEL_SRC_BIN=$(find . -type f -name "asl-recognition-0004.bin" | head -n 1)
cp "$MODEL_SRC_XML" "$OLDPWD/models/asl_recognizer.xml"
cp "$MODEL_SRC_BIN" "$OLDPWD/models/asl_recognizer.bin"
curl -L https://githubusercontent.com -o "$OLDPWD/models/gloss_labels.json"
cd "$OLDPWD"
rm -rf "$TEMP_DIR"