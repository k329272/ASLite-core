#!/usr/bin/env bash
set -euo pipefail

MODELS_DIR="models"
mkdir -p "$MODELS_DIR"

MODEL_XML_URL="https://storage.openvinotoolkit.org/repositories/open_model_zoo/2023.0/models_bin/1/asl-recognition-0004/FP32/asl-recognition-0004.xml"
MODEL_BIN_URL="https://storage.openvinotoolkit.org/repositories/open_model_zoo/2023.0/models_bin/1/asl-recognition-0004/FP32/asl-recognition-0004.bin"

if [ -f "$MODELS_DIR/optimized_model.zip" ]; then
    unzip -o "$MODELS_DIR/optimized_model.zip" -d "$MODELS_DIR/"
fi

download_file() {
    local url="$1"
    local output="$2"

    if command -v curl >/dev/null 2>&1; then
        curl -L --fail --retry 3 -o "$output" "$url"
    elif command -v wget >/dev/null 2>&1; then
        wget -O "$output" "$url"
    else
        echo "Error: neither curl nor wget is available." >&2
        exit 1
    fi
}

download_file "$MODEL_XML_URL" "$MODELS_DIR/asl_recognizer.xml"
download_file "$MODEL_BIN_URL" "$MODELS_DIR/asl_recognizer.bin"

if [ ! -f "$MODELS_DIR/gloss_labels.json" ]; then
    python3 - <<'PY'
import json
from pathlib import Path
path = Path("models/gloss_labels.json")
path.write_text(json.dumps([f"class_{i}" for i in range(100)]), encoding="utf-8")
PY
fi

echo "Downloaded ASL recognition model files to $MODELS_DIR/"